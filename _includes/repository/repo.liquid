<div class="repo p-2">
  <div class="repo-card">
    <div class="repo-card-header">
      <div class="repo-card-icon">
        <i class="fa-brands fa-github"></i>
      </div>

      <div class="repo-card-title-wrapper">
        <a
          href="{{ include.repository.url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="repo-name"
        >
          {{ include.repository.name }}
        </a>

        {% if include.repository.owner %}
          <span class="repo-owner">
            {{ include.repository.owner }}
          </span>
        {% endif %}
      </div>
    </div>

    {% if include.repository.description %}
      <p class="repo-description">
        {{ include.repository.description }}
      </p>
    {% endif %}

    {% if include.repository.technologies %}
      <div class="repo-technologies">
        {% assign technologies = include.repository.technologies | split: ' | ' %}
        {% for technology in technologies %}
          <span class="repo-tag">{{ technology }}</span>
        {% endfor %}
      </div>
    {% endif %}

    <div class="repo-card-footer">
      <a
        href="{{ include.repository.url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="repo-github-link"
      >
        <i class="fa-brands fa-github"></i>
        View repository
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
      </a>
    </div>
  </div>
</div>
