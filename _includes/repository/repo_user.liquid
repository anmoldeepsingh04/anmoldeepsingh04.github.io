<div class="repo p-2 text-center">
  <div class="repo-user-card">
    <a href="https://github.com/{{ include.username }}" class="repo-user-link">
      <div class="repo-user-icon">
        <i class="fab fa-github"></i>
      </div>

      <h3 class="repo-user-name">
        {{ include.username }}
      </h3>

      <p class="repo-user-description">GitHub profile and open-source projects</p>

      <span class="repo-user-button"> View GitHub Profile </span>
    </a>
  </div>
</div>
